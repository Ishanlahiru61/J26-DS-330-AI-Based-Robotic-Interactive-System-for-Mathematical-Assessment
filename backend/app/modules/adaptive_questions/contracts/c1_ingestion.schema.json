{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"C1 validated event accepted by Component2Service.ingest_c1",
  "type":"object",
  "required":["event_id","learner_id","activity_id","session_id","question_id","correct","attempt_count","timestamp"],
  "properties":{
    "event_id":{"type":"string","minLength":1},"learner_id":{"type":"string","minLength":1},
    "activity_id":{"type":"string","minLength":1},"session_id":{"type":"string","minLength":1},"question_id":{"type":"string","minLength":1},
    "correct":{"type":"integer","enum":[0,1]},"attempt_count":{"const":1},
    "timestamp":{"type":"string","format":"date-time"},"response_ms":{"type":["integer","null"],"minimum":0}
  }
}
